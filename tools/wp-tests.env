# Environment for the EPHEMERAL wp-phpunit harness (tools/run-phpunit-wp.sh,
# compose project cdd-wp-phpunit). These are throwaway values for a disposable
# localhost-only container destroyed with `down -v` — not secrets and never
# valid anywhere else. The developer environment keeps using the gitignored .env.
MARIADB_DATABASE=wptests
MARIADB_USER=wptests
MARIADB_PASSWORD=wptests-throwaway
MARIADB_ROOT_PASSWORD=wptests-throwaway-root
WORDPRESS_PORT=8083
