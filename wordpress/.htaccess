# Camino del Dharma — WordPress (Apache/LiteSpeed, Hostinger)
#
# Deployment artifact, not runtime code: copy to the WordPress document
# root at cutover (docs/operations/wordpress-manual-deployment.md).
#
# WordPress rewrites everything inside its own generated block
# whenever permalinks are saved. Every first-party rule
# therefore lives ABOVE that block, where WordPress never touches it, and
# runs before the front controller (docs/redirect-ledger.md).
#
# Ported from the static production .htaccess minus its static-only
# serving rules (DirectoryIndex, index.html rewriting, ErrorDocument):
# on WordPress those would shadow the front controller and manufacture
# soft 404s. WordPress renders its own 404 template with a 404 status.

Options -Indexes
AddDefaultCharset UTF-8

<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS si el servidor o el proxy no indican conexión segura
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
  RewriteRule ^ https://caminodeldharma.org%{REQUEST_URI} [R=301,L]

  # Dominio canónico: cualquier otro host -> sin www
  RewriteCond %{HTTP_HOST} !^caminodeldharma\.org$ [NC]
  RewriteRule ^ https://caminodeldharma.org%{REQUEST_URI} [R=301,L]

  # Manifest retirado: web tradicional, no PWA (ADR 0003)
  RewriteRule ^site\.webmanifest$ - [G,L]

  # Rutas antiguas -> URL canónica. Van ANTES de la regla de barra final
  # para que /encuentro-nacional-2026/ redirija una sola vez (sin cadena).
  RewriteRule ^sangha-refugio-hiperconexion/?$ /blog/sangha-refugio-hiperconexion [R=301,L]
  RewriteRule ^encuentro-nacional-2026/?$ /eventos/encuentro-nacional-2026 [R=301,L]
  RewriteRule ^pausa-profunda-cali/?$ /eventos/pausa-profunda-cali [R=301,L]

  # URLs residuales de la etapa WordPress todavia indexadas en buscadores
  # /prueba era una pagina de prueba sin equivalente: 410 para acelerar la desindexacion
  RewriteRule ^prueba/?$ - [G,L]
  # Archivos de categoria de WordPress -> blog. La categoria no esta en el
  # arbol de URLs (docs/11): WordPress la serviria, el 301 la retira.
  RewriteRule ^category(/.*)?$ /blog [R=301,L]
  # ?page_id=10 era "La comunidad" en WordPress
  RewriteCond %{QUERY_STRING} (^|&)page_id=10(&|$)
  RewriteRule ^$ /comunidad? [R=301,L]
  # Cualquier otro ?page_id= -> portada sin query
  RewriteCond %{QUERY_STRING} (^|&)page_id=
  RewriteRule ^$ /? [R=301,L]

  # sitemap.xml manual deprecado (ADR 0030) -> sitemap nativo del núcleo
  RewriteRule ^sitemap\.xml$ /wp-sitemap.xml [R=301,L]

  # Eliminar barra final, excepto la raíz (ADR 0008). Se salta wp-admin y
  # wp-json, que exigen la barra final del núcleo.
  RewriteCond %{REQUEST_URI} !^/(wp-admin|wp-json|wp-content|wp-includes)($|/)
  RewriteCond %{REQUEST_URI} !^/$
  RewriteCond %{REQUEST_URI} ^(.+)/$
  RewriteRule ^ %1 [R=301,L]
</IfModule>

<IfModule mod_mime.c>
  # Calendarios .ics: el servidor los entregaba como text/plain
  AddType text/calendar .ics
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE text/javascript application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"

  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/calendar "access plus 0 seconds"

  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"

  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"

  ExpiresByType audio/mpeg "access plus 30 days"
  ExpiresByType application/pdf "access plus 30 days"

  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header append Vary Accept-Encoding

  <FilesMatch "\.(css|js)$">
    Header always set Cache-Control "public, max-age=604800"
  </FilesMatch>

  <FilesMatch "\.(jpe?g|png|webp|avif|svg|mp3|pdf)$">
    Header always set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  <FilesMatch "\.woff2$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Permitted-Cross-Domain-Policies "none"

  # HSTS — ADR 0018: no se activa. Reconsiderar tras 30 días estables
  # después de un corte autorizado.
  # Header always set Strict-Transport-Security "max-age=604800"
</IfModule>

<Files ".htaccess">
  Require all denied
</Files>

# Archivos que no deben servirse desde el document root de WordPress.
<FilesMatch "^(wp-config\.php|readme\.html|license\.txt|xmlrpc\.php)$">
  Require all denied
</FilesMatch>

# BEGIN WordPress
# Las directivas (líneas) entre «BEGIN WordPress» y «END WordPress» son
# generadas dinámicamente y solo se deben modificar mediante los filtros
# de WordPress. Cualquier cambio en las directivas que hay entre esos
# marcadores será sobrescrito.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>

# END WordPress
