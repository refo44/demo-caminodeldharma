{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"custom": false,
			"customGradient": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"slug": "brand-1",
					"name": "Rojo oscuro",
					"color": "#8c2b3d"
				},
				{
					"slug": "brand-2",
					"name": "Rosa polvo",
					"color": "#b27474"
				},
				{
					"slug": "brand-3",
					"name": "Mauve claro",
					"color": "#d1aeab"
				},
				{
					"slug": "brand-4",
					"name": "Gris pizarra",
					"color": "#3e424b"
				},
				{
					"slug": "brand-1-deep",
					"name": "Rojo oscuro profundo (AA)",
					"color": "#7a2436"
				},
				{
					"slug": "brand-2-deep",
					"name": "Rosa polvo profundo (AA)",
					"color": "#9d6666"
				},
				{
					"slug": "text-on-dark",
					"name": "Texto sobre fondo oscuro",
					"color": "#fff"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "display",
					"name": "MarloweEscapade (display)",
					"fontFamily": "\"MarloweEscapade\", serif",
					"fontFace": [
						{
							"fontFamily": "MarloweEscapade",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/marlowe-escapade/marlowe-escapade-subset.woff2",
								"file:./assets/fonts/marlowe-escapade/marlowe-escapade.woff",
								"file:./assets/fonts/marlowe-escapade/marlowe-escapade.ttf"
							]
						}
					]
				},
				{
					"slug": "heading",
					"name": "Fjalla One (títulos)",
					"fontFamily": "\"Fjalla One\", serif",
					"fontFace": [
						{
							"fontFamily": "Fjalla One",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/fjalla-one/fjalla-one-latin-400-normal.woff2",
								"file:./assets/fonts/fjalla-one/fjalla-one.ttf"
							]
						}
					]
				},
				{
					"slug": "body",
					"name": "Inter (cuerpo)",
					"fontFamily": "\"Inter\", system-ui, -apple-system, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/inter/inter-latin-400-normal.woff2" ]
						},
						{
							"fontFamily": "Inter",
							"fontWeight": "600",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/inter/inter-latin-600-normal.woff2" ]
						},
						{
							"fontFamily": "Inter",
							"fontWeight": "400",
							"fontStyle": "italic",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/inter/inter-latin-400-italic.woff2" ]
						}
					]
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "xs",
					"name": "XS",
					"size": "0.5rem"
				},
				{
					"slug": "sm",
					"name": "SM",
					"size": "1rem"
				},
				{
					"slug": "md",
					"name": "MD",
					"size": "1.5rem"
				},
				{
					"slug": "lg",
					"name": "LG",
					"size": "2rem"
				},
				{
					"slug": "xl",
					"name": "XL",
					"size": "3rem"
				}
			]
		},
		"layout": {
			"contentSize": "65ch",
			"wideSize": "70rem"
		},
		"blocks": {
			"core/image": {
				"lightbox": {
					"enabled": true,
					"allowEditing": true
				}
			}
		},
		"custom": {
			"color": {
				"bg": "var(--wp--preset--color--brand-3)",
				"text": "var(--wp--preset--color--brand-4)",
				"textMuted": "var(--wp--preset--color--brand-4)",
				"surface": "var(--wp--preset--color--brand-3)",
				"border": "var(--wp--preset--color--brand-3)",
				"link": "var(--wp--preset--color--brand-1-deep)",
				"linkHover": "var(--wp--preset--color--brand-4)",
				"primary": "var(--wp--preset--color--brand-1)",
				"primaryHover": "var(--wp--preset--color--brand-2-deep)",
				"headerBg": "var(--wp--preset--color--brand-1)",
				"footerBg": "var(--wp--preset--color--brand-2-deep)",
				"textOnDark": "var(--wp--preset--color--text-on-dark)"
			},
			"lineHeight": {
				"body": 1.6,
				"tight": 1.35
			},
			"gutter": "1.5rem",
			"sectionGap": "3rem",
			"headerOffset": "7rem",
			"gridGap": "1.5rem"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--custom--color--bg)",
			"text": "var(--wp--custom--color--text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"lineHeight": "var(--wp--custom--line-height--body)"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--custom--color--link)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--custom--color--link-hover)"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"lineHeight": "var(--wp--custom--line-height--tight)"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Cabecera",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Pie",
			"area": "footer"
		}
	]
}
