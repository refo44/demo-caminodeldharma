{
  "config": {
    // Code blocks, tables, and headings are single lines in this repo.
    "MD013": {
      "line_length": 80,
      "code_blocks": false,
      "tables": false,
      "headings": false
    }
  },
  "ignores": [
    ".claude/skills/**/prompt.md",
    ".cursor/skills/**/prompt.md"
  ]
}
