# Template for the local Docker WordPress environment (ADR 0023).
# Copy to .env (gitignored) and set real values. Local-only credentials:
# never reuse Hostinger/staging/production values here.

# MariaDB (db service). Compose fails fast if any of these is missing.
MARIADB_DATABASE=caminodeldharma_local
MARIADB_USER=cdd_local
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me-too

# Local port WordPress listens on (localhost only). Optional; default 8080.
WORDPRESS_PORT=8080
