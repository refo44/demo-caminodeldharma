{
  "name": "demo-caminodeldharma",
  "version": "1.0.35",
  "private": true,
  "description": "Maqueta estática del sitio web de la Comunidad Buddhista Camino del Dharma (Colombia). Sitio estático; npm solo se usa para herramientas de desarrollo.",
  "license": "MIT",
  "author": "Rafael Figueredo Oropeza",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "lint:css": "stylelint \"static/assets/css/**/*.css\"",
    "build:css": "cleancss -O2 -o static/assets/css/main.min.css static/assets/css/main.css",
    "build:docx": "node scripts/build-docx/build.js",
    "check:docx": "python3 scripts/build-docx/check.py"
  },
  "devDependencies": {
    "clean-css-cli": "^5.6.3",
    "docx": "^9.7.1",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1"
  }
}
